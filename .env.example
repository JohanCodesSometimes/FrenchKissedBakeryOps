BAKERYOPS_USER=owner
BAKERYOPS_PASSWORD=replace-with-a-strong-dashboard-password
HOST=0.0.0.0
PORT=4173
DATA_DIR=./data

# Square
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=replace-with-square-application-id
SQUARE_APPLICATION_SECRET=replace-with-square-application-secret
SQUARE_OAUTH_REDIRECT_URL=https://your-railway-domain.up.railway.app/api/square/oauth/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-square-webhook-signature-key
SQUARE_WEBHOOK_URL=https://your-railway-domain.up.railway.app/api/square/webhook
SQUARE_VERSION=2026-05-20

# Optional fallback for single-account testing. OAuth is preferred.
SQUARE_ACCESS_TOKEN=
