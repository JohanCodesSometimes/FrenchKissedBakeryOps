BAKERYOPS_USER=owner
BAKERYOPS_PASSWORD=replace-with-a-strong-dashboard-password
HOST=0.0.0.0
PORT=4173
DATA_DIR=./data

# Optional Supabase storage. Set all three together to enable it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Square POS integration. Secrets remain server-side.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_REDIRECT_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_VERSION=2026-05-20

# Backend document preprocessing.
PYTHON_BIN=
MAX_DOCUMENT_UPLOAD_MB=20

# Server-only receipt image parsing.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
